# LLM provider: "ollama" (local, default) or "groq" (hosted demo)
LLM_PROVIDER=ollama

# Model name (defaults: llama3.2:1b for ollama, llama-3.3-70b-versatile for groq)
LLM_MODEL=llama3.2:1b

# Ollama server base URL
OLLAMA_HOST=http://localhost:11434

# Only with LLM_PROVIDER=groq. Set it in your environment / host settings, never commit it.
# GROQ_API_KEY=

# Directory where uploaded files are stored (relative to project root)
UPLOAD_DIR=uploads

# Maximum allowed upload size in megabytes
MAX_FILE_SIZE_MB=10
